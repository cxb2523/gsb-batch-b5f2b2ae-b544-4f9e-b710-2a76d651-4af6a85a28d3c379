{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "community-iptv-player",
  "main": "worker/index.ts",
  // >= 2024-11-11 so `cache: "no-store"` in worker/index.ts is enabled.
  "compatibility_date": "2026-08-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // "none", not "single-page-application": the blanket SPA fallback answered
    // every bogus URL with index.html and a 200, so scanner probes like
    // /common/.env came back as "found" and crawlers saw soft 404s. The Worker
    // boots index.html for the real client-side routes and 404s the rest.
    "not_found_handling": "none",
    // The Worker must see every request so it can force HTTPS; asset serving
    // still happens via the ASSETS binding.
    "run_worker_first": ["/*"]
  },
  // Wrangler provisions this custom domain AND its DNS record on deploy — the
  // Workers API covers it, so it does not need a DNS-scoped token.
  "routes": [{ "pattern": "ctv.1guy.dev", "custom_domain": true }]
}
